# Secrets & credentials
.env
.env.*
!.env.example
service_account.json
secrets/
.secrets/

# Runtime data
data/
__pycache__/
*.pyc
*.pyo
*.db
*.log

# Dependencies
node_modules/

# Credential files and directories (beyond .env)
credentials/
service_account*.json
*.pem
*.key

# Ad-hoc backup files/dirs (git history is the real backup now)
*.bak
*.bak.*
.env-backup-*/

# Transient runtime output, not source
tempjson/
summaries/

# Model weights / caches (too big for GitHub)
weekly-returns-classifier/work/
weekly-returns-classifier/state/
weekly-returns-classifier/logs/

# Service-account keys anywhere
gsa-key*.json
*-sa-key*.json

# Dated backup copies (e.g. job.py.bak-20261012)
*.bak-*
